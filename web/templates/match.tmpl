{{define "matchLayout"}}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>match-history{{if .GameModeLabel}} — {{.GameModeLabel}}{{end}}</title>
{{template "themeInit" .}}
<link rel="stylesheet" href="{{styleURL}}">
</head>
<body>
{{template "topbar" .}}
<main class="match-main">
{{template "matchContent" .}}
</main>
{{template "copyScript" .}}
</body>
</html>
{{end}}

{{define "matchContent"}}
<a class="back-link" href="/?q={{.Query}}&amp;region={{.Region}}">&larr; Match History</a>

{{if .Error}}
<div class="error">{{.Error}}</div>
{{else}}
<div class="detail-meta">
  <span class="mode">{{.GameModeLabel}}</span>
  <span class="muted">{{.DurationLabel}}</span>
  <span class="muted">{{.TimeAgoLabel}}</span>
  <button type="button" class="btn muted copy-link" onclick="copyMatchLink(this)">Copy Link</button>
</div>

{{template "teamGroup" .Team1}}
{{template "teamGroup" .Team2}}
{{end}}
{{end}}

{{define "teamGroup"}}
<div class="section-label">{{if .Win}}Victory{{else}}Defeat{{end}}<span class="rule"></span></div>
<div class="panel scoreboard-panel">
  <div class="team-head {{if .Win}}win{{else}}loss{{end}}">
    <span>team totals</span>
    <span class="totals">{{.TotalKills}}/{{.TotalDeaths}}/{{.TotalAssists}} &middot; {{.TotalGold}}g</span>
  </div>
  <div class="objective-strip">
    <span>towers <b>{{.Objectives.Towers}}</b></span>
    <span>dragons <b>{{.Objectives.Dragons}}</b></span>
    <span>barons <b>{{.Objectives.Barons}}</b></span>
    <span>heralds <b>{{.Objectives.Heralds}}</b></span>
    <span>grubs <b>{{.Objectives.Grubs}}</b></span>
  </div>
  <table class="scoretable">
    <colgroup>
      <col class="player-col">
      <col style="width:96px">
      <col style="width:76px">
      <col style="width:64px">
      <col style="width:76px">
      <col style="width:162px">
      <col style="width:92px">
      <col style="width:296px">
    </colgroup>
    <thead><tr><th>player</th><th>kda</th><th>cs</th><th>cs@10m</th><th>gold</th><th>damage</th><th>vision</th><th>items</th></tr></thead>
    <tbody>
      {{range .Players}}
      <tr{{if .IsHighlighted}} class="me"{{end}}>
        <td class="player-cell">
          <div class="player-inner">
            <div class="champ-portrait">
              <img class="champ-icon-img" src="{{.ChampionIconURL}}" alt="{{.ChampionName}}">
              {{if gt .ChampionLevel 0}}<span class="champ-level">{{.ChampionLevel}}</span>{{end}}
            </div>
            <div class="spell-col">
              {{range .SummonerSpellIconURLs}}<img class="spell-icon-img" src="{{.}}" alt="">{{end}}
            </div>
            <div class="player-identity">
              <a class="riot-id" href="/?q={{.RiotID}}&amp;region={{.Region}}">{{.RiotID}}</a>
              {{with .PerformanceLabels}}<div class="performance-labels">{{range .}}<span class="performance-tag {{.Tone}}" title="{{.Description}}">{{.Text}}</span>{{end}}</div>{{end}}
            </div>
          </div>
        </td>
        <td class="num-cell" data-label="kda">{{.Kills}}/{{.Deaths}}/{{.Assists}}</td>
        <td class="num-cell metric-stack" data-label="cs"><span>{{.CS}}</span><small>{{formatDecimal .CSPerMinute}}/min</small></td>
        <td class="num-cell" data-label="cs@10m">{{with .LaneMinionsFirst10Minutes}}{{.}}{{else}}—{{end}}</td>
        <td class="num-cell metric-stack" data-label="gold"><span>{{.Gold}}</span><small>{{formatDecimal .GoldPerMinute}}/min</small></td>
        <td class="dmg-cell" data-label="damage">
          <div class="dmg-inner">
            <div class="dmg-bar-track"><div class="dmg-bar-fill" style="width:{{.DamagePercent}}%"></div></div>
            <span class="metric-stack dmg-num"><span>{{.Damage}}</span><small>{{formatDecimal .DamagePerMinute}}/min</small></span>
          </div>
        </td>
        <td class="num-cell metric-stack" data-label="vision"><span>{{.VisionScore}}</span><small>{{formatDecimal .VisionPerMinute}}/min · {{.ControlWards}} cw</small></td>
        <td class="items-cell" data-label="items">
          <div class="items-inner">
            {{range .ItemIconURLs}}{{if .}}<img class="item-slot-img" src="{{.}}" alt="">{{else}}<span class="item-slot empty"></span>{{end}}{{end}}
          </div>
        </td>
      </tr>
      {{end}}
    </tbody>
  </table>
</div>
{{end}}

{{define "copyScript"}}
<script>
function copyMatchLink(button) {
  var matchURL = window.location.origin + window.location.pathname;
  function done() {
    button.textContent = 'Copied';
    window.setTimeout(function () { button.textContent = 'Copy Link'; }, 1500);
  }
  if (navigator.clipboard && window.isSecureContext) {
    navigator.clipboard.writeText(matchURL).then(done);
    return;
  }
  var input = document.createElement('textarea');
  input.value = matchURL;
  input.setAttribute('readonly', '');
  input.style.position = 'fixed';
  input.style.opacity = '0';
  document.body.appendChild(input);
  input.select();
  if (document.execCommand('copy')) done();
  document.body.removeChild(input);
}
</script>
{{end}}
