{{define "content"}}
{{if .Error}}
<div class="error">{{.Error}}</div>
{{end}}

{{if .Profile}}
<div class="profile">
  <img class="avatar-img" src="{{.Profile.ProfileIconURL}}" alt="">
  <div>
    <div class="profile-name">{{.Profile.GameName}}<span class="tag">#{{.Profile.TagLine}}</span></div>
    <div class="profile-level">level {{.Profile.SummonerLevel}}</div>
  </div>
  <div class="update-block">
    <div class="profile-actions">
      <form method="get" action="/">
        <input type="hidden" name="q" value="{{.Query}}">
        <input type="hidden" name="region" value="{{.Region}}">
        <input type="hidden" name="count" value="{{.RequestedMatches}}">
        <input type="hidden" name="refresh" value="1">
        <button type="submit" class="btn muted">Update</button>
      </form>
      {{if .LiveGameURL}}<a class="btn live-game-btn" href="{{.LiveGameURL}}"><span class="live-dot" aria-hidden="true"></span>Live Game</a>{{end}}
    </div>
    <div class="last-updated">{{.LastUpdatedLabel}}</div>
  </div>
</div>

{{with .RecentSummary}}
<div class="section-label">last {{.Games}} matches<span class="rule"></span></div>
<div class="panel recent-summary">
  <div class="summary-stat"><span class="v">{{formatSignedDecimal .AverageGoldDeltaAt15}}</span><span class="k">gold diff @15</span></div>
  <div class="summary-stat"><span class="v">{{formatSignedDecimal .AverageXPDeltaAt15}}</span><span class="k">xp diff @15</span></div>
  <div class="summary-stat"><span class="v">{{formatSignedDecimal .AverageCSDeltaAt15}}</span><span class="k">cs diff @15</span></div>
  <div class="summary-stat"><span class="v">{{formatDecimal .DeathsPer10Minutes}}</span><span class="k">deaths / 10m</span></div>
</div>
{{end}}

<div class="dashboard-grid">
<aside class="dashboard-sidebar">
<div class="section-label">ranked<span class="rule"></span></div>
<div class="panel">
  <div class="panel-row rank-row">
    <div class="rank-queue">solo/duo</div>
    <div class="rank-detail">
      {{if .Profile.SoloRank}}<b>{{.Profile.SoloRank.Tier}} {{.Profile.SoloRank.Division}}</b> {{.Profile.SoloRank.LeaguePoints}}lp &middot; {{.Profile.SoloRank.Wins}}w {{.Profile.SoloRank.Losses}}l &middot; {{.Profile.SoloRank.WinRatePercent}}%{{else}}unranked{{end}}
    </div>
  </div>
  <div class="panel-row rank-row">
    <div class="rank-queue">flex 5v5</div>
    <div class="rank-detail">
      {{if .Profile.FlexRank}}<b>{{.Profile.FlexRank.Tier}} {{.Profile.FlexRank.Division}}</b> {{.Profile.FlexRank.LeaguePoints}}lp &middot; {{.Profile.FlexRank.Wins}}w {{.Profile.FlexRank.Losses}}l &middot; {{.Profile.FlexRank.WinRatePercent}}%{{else}}unranked{{end}}
    </div>
  </div>
</div>

{{with .RecentSummary}}{{with .Champions}}
<div class="section-label">recent champions<span class="rule"></span></div>
<div class="panel summary-list">
  {{range .}}
  <div class="panel-row champion-summary-row">
    <img class="champ-icon-img" src="{{.ChampionIconURL}}" alt="{{.ChampionName}}">
    <div class="summary-name"><b>{{.ChampionName}}</b><span>{{.Games}} games · {{.WinRatePercent}}% wr</span></div>
    <div class="mini-stat"><b>{{printf "%.2f" .AverageKDA}}</b><span>kda</span></div>
    <div class="mini-stat"><b>{{formatDecimal .AverageCSPerMinute}}</b><span>cs/min</span></div>
  </div>
  {{end}}
</div>
{{end}}{{end}}

{{with .RecentSummary}}{{with .Roles}}
<div class="section-label">recent roles<span class="rule"></span></div>
<div class="panel role-summary">
  {{range .}}
  <div class="role-stat"><b>{{.Role}}</b><span>{{.Games}} games</span><span>{{.WinRatePercent}}% wr</span></div>
  {{end}}
</div>
{{end}}{{end}}

 </aside>

<section class="match-column">
<div class="section-label">recent matches<span class="rule"></span></div>
<div class="panel matches-panel">
{{range .Matches}}
  <a class="panel-row match-row {{if .Win}}win{{else}}loss{{end}}" href="/match/{{.MatchID}}?me={{$.Query}}">
    <span class="tag-badge">{{if .Win}}VICTORY{{else}}DEFEAT{{end}}</span>
    <div class="result-block">{{.GameModeLabel}}<br>{{.TimeAgoLabel}}</div>

    <div class="champ-block">
      <img class="champ-icon-img" src="{{.ChampionIconURL}}" alt="{{.ChampionName}}">
      <div class="spell-col">
        {{range .SummonerSpellIconURLs}}<img class="spell-icon-img" src="{{.}}" alt="">{{end}}
      </div>
    </div>

    <div class="items-row">
      {{range .ItemIconURLs}}{{if .}}<img class="item-slot-img" src="{{.}}" alt="">{{else}}<span class="item-slot empty"></span>{{end}}{{end}}
    </div>

    <div class="stat-cluster">
      <div class="stat"><span class="v">{{.Kills}}/{{.Deaths}}/{{.Assists}}</span><br><span class="k">kda</span></div>
      <div class="stat"><span class="v">{{.CS}}</span><br><span class="k">cs</span></div>
    </div>
  </a>
{{end}}
</div>
{{if .CanLoadMore}}
<form class="load-more-form" method="get" action="/">
  <input type="hidden" name="q" value="{{.Query}}">
  <input type="hidden" name="region" value="{{.Region}}">
  <input type="hidden" name="count" value="{{.NextMatchCount}}">
  <button type="submit" class="btn muted">Load 10 More</button>
</form>
{{end}}
</section>
</div>
{{end}}
{{end}}
