{{define "liveLayout"}}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>live game{{if .Query}} — {{.Query}}{{end}}</title>
{{template "themeInit" .}}
<link rel="stylesheet" href="{{styleURL}}">
</head>
<body>
{{template "topbar" .}}
<main class="live-main">
{{template "liveContent" .}}
</main>
</body>
</html>
{{end}}

{{define "liveContent"}}
<a class="back-link" href="/?q={{.Query}}&region={{.Region}}">← Back to Match History</a>
{{if .Error}}<div class="error">{{.Error}}</div>{{end}}
{{with .Game}}
<section class="live-hero">
  <div class="live-hero-title">
    <span class="live-kicker"><span class="live-dot" aria-hidden="true"></span>Live match</span>
    <h1>{{.QueueLabel}}</h1>
    <p>Every player’s current <b>{{.RankQueueLabel}}</b> season record</p>
  </div>
  <div class="live-clock" data-live-seconds="{{.GameLengthSeconds}}">
    <span class="live-clock-value">{{.GameLengthLabel}}</span>
    <small>game time</small>
  </div>
</section>

<div class="live-board">
  {{template "liveTeam" .Team1}}
  {{template "liveTeam" .Team2}}
</div>

<script>
(function(){
  var clock = document.querySelector('[data-live-seconds]');
  if (!clock) return;
  var seconds = Number(clock.getAttribute('data-live-seconds')) || 0;
  var value = clock.querySelector('.live-clock-value');
  window.setInterval(function(){
    seconds += 1;
    var minutes = Math.floor(seconds / 60);
    var remainder = String(seconds % 60).padStart(2, '0');
    value.textContent = minutes + 'm ' + remainder + 's';
  }, 1000);
})();
</script>
{{end}}
{{end}}

{{define "liveTeam"}}
<section class="live-team {{if eq .TeamID 100}}blue{{else}}red{{end}}">
  <header class="live-team-head">
    <span class="live-team-orb" aria-hidden="true"></span>
    <span>{{if eq .TeamID 100}}blue team{{else}}red team{{end}}</span>
    <small>5 players</small>
  </header>
  <div class="live-roster">
  {{range .Players}}
  <article class="live-player {{if .IsSearchedPlayer}}me{{end}}">
    <div class="live-champion">
      {{if .ChampionIconURL}}<img src="{{.ChampionIconURL}}" alt="{{.ChampionName}}">{{else}}<span class="live-champion-fallback" aria-hidden="true"></span>{{end}}
      <span class="live-champion-name">{{.ChampionName}}</span>
      {{if .IsSearchedPlayer}}<span class="live-you-badge">YOU</span>{{end}}
    </div>
    <div class="live-card-body">
      <div class="live-player-name"><b>{{if .ProfileURL}}<a href="{{.ProfileURL}}">{{.RiotID}}</a>{{else}}{{.RiotID}}{{end}}</b></div>
      <div class="live-rank">
        {{if .RankError}}
          <b>Unavailable</b><span>{{.RankError}}</span>
        {{else if .Rank}}
          <b>{{.Rank.Tier}} {{.Rank.Division}}</b>
          <span>{{.Rank.LeaguePoints}} LP</span>
        {{else}}
          <b>Unranked</b><span>Solo/Duo</span>
        {{end}}
      </div>
      {{if .Rank}}
      <div class="live-record">
        <span><b>{{.Rank.Wins}}</b><small>wins</small></span>
        <span><b>{{.Rank.Losses}}</b><small>losses</small></span>
        <span><b>{{.Rank.WinRatePercent}}%</b><small>win rate</small></span>
      </div>
      {{end}}
    </div>
  </article>
  {{end}}
  </div>
</section>
{{end}}
